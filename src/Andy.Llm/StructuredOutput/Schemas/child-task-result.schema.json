{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ChildTaskResult",
  "description": "The bounded answer produced by executing a single child task of an analysis plan.",
  "type": "object",
  "additionalProperties": false,
  "required": ["taskId", "status", "answer"],
  "properties": {
    "taskId": {
      "type": "string",
      "minLength": 1,
      "description": "Id of the plan task this result belongs to."
    },
    "status": {
      "type": "string",
      "enum": ["completed", "partial", "failed"]
    },
    "answer": {
      "type": "string",
      "minLength": 1,
      "description": "The bounded answer to the child task's instructions."
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title"],
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "uri": { "type": "string" }
        }
      }
    },
    "tokensUsed": {
      "type": "integer",
      "minimum": 0,
      "description": "Tokens spent producing this result, when tracked."
    }
  }
}
